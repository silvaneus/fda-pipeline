node_modules/
data/*.json
data/*.txt
.DS_Store

# state/ is intentionally tracked: the rolling news window and the CBER
# snapshot only work if they survive between nightly runs.

# Pipeline 2.0: the MJH article cache (~70 MB) lives in the Actions cache, not git.
# Only the small files a nightly run needs to fall back on are tracked.
pipeline2/state/*
!pipeline2/state/catalysts.json
!pipeline2/state/web-checks.json
!pipeline2/state/rttnews.json
!pipeline2/state/openfda-brands.json
!pipeline2/state/verify-*.json
pipeline2/reports/
